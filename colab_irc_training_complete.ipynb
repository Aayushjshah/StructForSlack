    "class ColabConfig:\n",
    "    \"\"\"Configuration class for Google Colab environment optimization\"\"\"\n",
    "    \n",
    "    def __init__(self):\n",
    "        self.device = self._detect_device()\n",
    "        self.gpu_memory = self._get_gpu_memory()\n",
    "        self.batch_size, self.max_seq_length = self._optimize_memory_settings()\n",
    "        self.mixed_precision = torch.cuda.is_available()\n",
    "        self.gradient_checkpointing = True\n",
    "        \n",
    "    def _detect_device(self):\n",
    "        \"\"\"Detect available device (TPU > GPU > CPU)\"\"\"\n",
    "        try:\n",
    "            import torch_xla.core.xla_model as xm\n",
    "            return 'tpu'\n",
    "        except ImportError:\n",
    "            if torch.cuda.is_available():\n",
    "                return 'cuda'\n",
    "            else:\n",
    "                return 'cpu'\n",
    "    \n",
    "    def _get_gpu_memory(self):\n",
    "        \"\"\"Get available GPU memory in GB\"\"\"\n",
    "        if self.device == 'cuda':\n",
    "            gpu_memory = torch.cuda.get_device_properties(0).total_memory / (1024**3)\n",
    "            return gpu_memory\n",
    "        return 0\n",
    "    \n",
    "    def _optimize_memory_settings(self):\n",
    "        \"\"\"Optimize batch size and sequence length based on available memory\"\"\"\n",
    "        if self.device == 'tpu':\n",
    "            return 8, 512  # TPU optimized\n",
    "        elif self.device == 'cuda':\n",
    "            if self.gpu_memory >= 15:  # T4/V100 or better\n",
    "                return 4, 512\n",
    "            elif self.gpu_memory >= 12:  # T4\n",
    "                return 2, 256\n",
    "            else:  # Smaller GPU\n",
    "                return 1, 128\n",
    "        else:  # CPU\n",
    "            return 1, 128\n",
    "    \n",
    "    def print_config(self):\n",
    "        \"\"\"Print current configuration\"\"\"\n",
    "        print(f\"\\n=== Colab Configuration ===\")\n",
    "        print(f\"Device: {self.device}\")\n",
    "        if self.device == 'cuda':\n",
    "            print(f\"GPU Memory: {self.gpu_memory:.1f} GB\")\n",
    "        print(f\"Batch Size: {self.batch_size}\")\n",
    "        print(f\"Max Sequence Length: {self.max_seq_length}\")\n",
    "        print(f\"Mixed Precision: {self.mixed_precision}\")\n",
    "        print(f\"Gradient Checkpointing: {self.gradient_checkpointing}\")\n",
    "        print(\"============================\\n\")\n",
    "\n",
    "# Initialize configuration\n",
    "config = ColabConfig()\n",
    "config.print_config()"
   ]
  },
