    "def download_and_extract_dataset():\n",
    "    \"\"\"Download IRC disentanglement dataset from GitHub\"\"\"\n",
    "    data_url = \"https://github.com/jkkummerfeld/irc-disentanglement/tarball/master\"\n",
    "    data_dir = \"irc_data\"\n",
    "    \n",
    "    if os.path.exists(data_dir):\n",
    "        print(f\"Dataset already exists in {data_dir}\")\n",
    "        return data_dir\n",
    "    \n",
    "    print(\"Downloading IRC disentanglement dataset...\")\n",
    "    \n",
    "    # Download the tarball\n",
    "    tarball_path = \"irc_dataset.tar.gz\"\n",
    "    urllib.request.urlretrieve(data_url, tarball_path)\n",
    "    \n",
    "    print(\"Extracting dataset...\")\n",
    "    # Extract the tarball\n",
    "    with tarfile.open(tarball_path, 'r:gz') as tar:\n",
    "        tar.extractall()\n",
    "    \n",
    "    # Find the extracted directory (it will have a hash in the name)\n",
    "    extracted_dirs = [d for d in os.listdir('.') if d.startswith('jkkummerfeld-irc-disentanglement')]\n",
    "    \n",
    "    if extracted_dirs:\n",
    "        extracted_dir = extracted_dirs[0]\n",
    "        os.rename(extracted_dir, data_dir)\n",
    "        print(f\"Dataset extracted to {data_dir}\")\n",
    "    else:\n",
    "        raise FileNotFoundError(\"Could not find extracted dataset directory\")\n",
    "    \n",
    "    # Clean up\n",
    "    os.remove(tarball_path)\n",
    "    \n",
    "    return data_dir\n",
    "\n",
    "# Download the dataset\n",
    "DATA_DIR = download_and_extract_dataset()\n",
    "print(f\"Dataset available at: {DATA_DIR}\")\n",
    "\n",
    "# Check available data files\n",
    "train_files = list(Path(DATA_DIR).glob(\"data/train/*.annotation.txt\"))\n",
    "dev_files = list(Path(DATA_DIR).glob(\"data/dev/*.annotation.txt\"))\n",
    "test_files = list(Path(DATA_DIR).glob(\"data/test/*.annotation.txt\"))\n",
    "\n",
    "print(f\"\\nAvailable data:\")\n",
    "print(f\"Train files: {len(train_files)}\")\n",
    "print(f\"Dev files: {len(dev_files)}\")\n",
    "print(f\"Test files: {len(test_files)}\")"
   ]
