   "source": [
    "class MemoryOptimizedBertV2(nn.Module):\n",
    "    \"\"\"Memory-optimized BERT model for IRC conversation disentanglement\"\"\"\n",
    "    \n",
    "    def __init__(self, config):\n",
    "        super().__init__()\n",
    "        self.config = config\n",
    "        self.max_seq_length = config.max_seq_length\n",
    "        \n",
    "        # Initialize BERT with smaller hidden dimensions for memory efficiency\n",
    "        bert_config = BertConfig(\n",
    "            vocab_size=30522,\n",
    "            hidden_size=512,  # Reduced from 768\n",
    "            num_hidden_layers=6,  # Reduced from 12\n",
    "            num_attention_heads=8,  # Reduced from 12\n",
    "            intermediate_size=1024,  # Reduced from 3072\n",
    "            max_position_embeddings=512,\n",
    "            gradient_checkpointing=config.gradient_checkpointing\n",
    "        )\n",
    "        \n",
    "        self.bert = BertModel(bert_config)\n",
    "        \n",
    "        # Simplified architecture for memory efficiency\n",
    "        self.hidden_size = bert_config.hidden_size\n",
    "        self.lstm_hidden = 64  # Reduced LSTM hidden size\n",
    "        \n",
    "        # LSTM for sequence modeling\n",
    "        self.lstm = nn.LSTM(\n",
    "            input_size=self.hidden_size,\n",
    "            hidden_size=self.lstm_hidden,\n",
    "            num_layers=1,  # Single layer for memory efficiency\n",
    "            batch_first=True,\n",
    "            bidirectional=True,\n",
    "            dropout=0.1\n",
    "        )\n",
    "        \n",
    "        # Attention mechanism\n",
    "        self.attention = nn.MultiheadAttention(\n",
    "            embed_dim=self.lstm_hidden * 2,  # bidirectional\n",
    "            num_heads=4,  # Reduced heads\n",
    "            dropout=0.1,\n",
    "            batch_first=True\n",
    "        )\n",
    "        \n",
    "        # Classification layers\n",
    "        self.dropout = nn.Dropout(0.3)\n",
    "        self.classifier = nn.Sequential(\n",
    "            nn.Linear(self.lstm_hidden * 2, 64),\n",
    "            nn.ReLU(),\n",
    "            nn.Dropout(0.2),\n",
    "            nn.Linear(64, 2)  # Binary classification\n",
    "        )\n",
    "        \n",
    "        # Layer normalization\n",
    "        self.layer_norm = nn.LayerNorm(self.lstm_hidden * 2)\n",
    "        \n",
    "    def forward(self, input_ids, attention_mask=None, labels=None):\n",
    "        # BERT encoding with gradient checkpointing if enabled\n",
    "        if self.config.gradient_checkpointing and self.training:\n",
    "            self.bert.gradient_checkpointing_enable()\n",
    "        \n",
    "        bert_outputs = self.bert(\n",
    "            input_ids=input_ids,\n",
    "            attention_mask=attention_mask\n",
    "        )\n",
    "        \n",
    "        sequence_output = bert_outputs.last_hidden_state  # [batch, seq_len, hidden]\n",
    "        \n",
    "        # LSTM processing\n",
    "        lstm_output, _ = self.lstm(sequence_output)\n",
    "        \n",
    "        # Self-attention\n",
    "        attended_output, _ = self.attention(\n",
    "            lstm_output, lstm_output, lstm_output,\n",
    "            key_padding_mask=~attention_mask.bool() if attention_mask is not None else None\n",
    "        )\n",
    "        \n",
    "        # Layer normalization and dropout\n",
    "        attended_output = self.layer_norm(attended_output)\n",
    "        attended_output = self.dropout(attended_output)\n",
    "        \n",
    "        # Classification (use [CLS] token representation)\n",
    "        cls_output = attended_output[:, 0, :]  # [batch, hidden]\n",
    "        logits = self.classifier(cls_output)\n",
    "        \n",
    "        outputs = {'logits': logits}\n",
    "        \n",
    "        if labels is not None:\n",
    "            loss_fct = nn.CrossEntropyLoss()\n",
    "            loss = loss_fct(logits, labels)\n",
    "            outputs['loss'] = loss\n",
    "        \n",
    "        return outputs\n",
    "    \n",
    "    def get_memory_usage(self):\n",
    "        \"\"\"Get current memory usage of the model\"\"\"\n",
    "        total_params = sum(p.numel() for p in self.parameters())\n",
    "        trainable_params = sum(p.numel() for p in self.parameters() if p.requires_grad)\n",
    "        \n",
    "        param_memory = total_params * 4 / (1024**2)  # 4 bytes per parameter, convert to MB\n",
    "        \n",
    "        return {\n",
    "            'total_params': total_params,\n",
    "            'trainable_params': trainable_params,\n",
    "            'param_memory_mb': param_memory\n",
    "        }\n",
    "\n",
    "print(\"Model class defined successfully!\")"
   ]
  },
