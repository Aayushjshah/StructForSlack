    "class IRCDataset(Dataset):\n",
    "    \"\"\"Dataset class for IRC conversation disentanglement\"\"\"\n",
    "    \n",
    "    def __init__(self, file_paths, tokenizer, max_length=512, max_samples=None):\n",
    "        self.tokenizer = tokenizer\n",
    "        self.max_length = max_length\n",
    "        self.samples = []\n",
    "        \n",
    "        print(f\"Loading data from {len(file_paths)} files...\")\n",
    "        \n",
    "        sample_count = 0\n",
    "        for file_path in tqdm(file_paths, desc=\"Processing files\"):\n",
    "            file_samples = self._process_file(file_path)\n",
    "            self.samples.extend(file_samples)\n",
    "            sample_count += len(file_samples)\n",
    "            \n",
    "            if max_samples and sample_count >= max_samples:\n",
    "                self.samples = self.samples[:max_samples]\n",
    "                break\n",
    "        \n",
    "        print(f\"Loaded {len(self.samples)} samples\")\n",
    "    \n",
    "    def _process_file(self, file_path):\n",
    "        \"\"\"Process a single annotation file\"\"\"\n",
    "        samples = []\n",
    "        \n",
    "        try:\n",
    "            with open(file_path, 'r', encoding='utf-8', errors='ignore') as f:\n",
    "                lines = f.readlines()\n",
    "            \n",
    "            conversations = defaultdict(list)\n",
    "            \n",
    "            # Parse annotations\n",
    "            for line in lines:\n",
    "                line = line.strip()\n",
    "                if not line or line.startswith('#'):\n",
    "                    continue\n",
    "                \n",
    "                parts = line.split('\\t')\n",
    "                if len(parts) >= 4:\n",
    "                    timestamp = parts[0]\n",
    "                    speaker = parts[1]\n",
    "                    message = parts[2]\n",
    "                    thread_id = parts[3] if parts[3] != '-' else '0'\n",
    "                    \n",
    "                    # Create positive samples (same thread)\n",
    "                    conversations[thread_id].append({\n",
    "                        'timestamp': timestamp,\n",
    "                        'speaker': speaker,\n",
    "                        'message': message,\n",
    "                        'thread_id': thread_id\n",
    "                    })\n",
    "            \n",
    "            # Generate training pairs\n",
    "            all_messages = []\n",
    "            for thread_messages in conversations.values():\n",
    "                all_messages.extend(thread_messages)\n",
    "            \n",
    "            # Create positive pairs (same thread)\n",
    "            for thread_id, messages in conversations.items():\n",
    "                if len(messages) > 1:\n",
    "                    for i in range(len(messages) - 1):\n",
    "                        msg1 = messages[i]\n",
    "                        msg2 = messages[i + 1]\n",
    "                        \n",
    "                        text = f\"{msg1['speaker']}: {msg1['message']} [SEP] {msg2['speaker']}: {msg2['message']}\"\n",
    "                        samples.append({'text': text, 'label': 1})  # Same thread\n",
    "            \n",
    "            # Create negative pairs (different threads)\n",
    "            thread_ids = list(conversations.keys())\n",
    "            if len(thread_ids) > 1:\n",
    "                for i in range(min(len(samples), 100)):  # Limit negative samples\n",
    "                    thread1, thread2 = random.sample(thread_ids, 2)\n",
    "                    if conversations[thread1] and conversations[thread2]:\n",
    "                        msg1 = random.choice(conversations[thread1])\n",
    "                        msg2 = random.choice(conversations[thread2])\n",
    "                        \n",
    "                        text = f\"{msg1['speaker']}: {msg1['message']} [SEP] {msg2['speaker']}: {msg2['message']}\"\n",
    "                        samples.append({'text': text, 'label': 0})  # Different threads\n",
    "        \n",
    "        except Exception as e:\n",
    "            print(f\"Error processing {file_path}: {e}\")\n",
    "        \n",
    "        return samples\n",
    "    \n",
    "    def __len__(self):\n",
    "        return len(self.samples)\n",
    "    \n",
    "    def __getitem__(self, idx):\n",
    "        sample = self.samples[idx]\n",
    "        text = sample['text']\n",
    "        label = sample['label']\n",
    "        \n",
    "        # Tokenize\n",
    "        encoding = self.tokenizer(\n",
    "            text,\n",
    "            truncation=True,\n",
    "            padding='max_length',\n",
    "            max_length=self.max_length,\n",
    "            return_tensors='pt'\n",
    "        )\n",
    "        \n",
    "        return {\n",
    "            'input_ids': encoding['input_ids'].squeeze(),\n",
    "            'attention_mask': encoding['attention_mask'].squeeze(),\n",
    "            'labels': torch.tensor(label, dtype=torch.long)\n",
    "        }\n",
    "\n",
    "print(\"Dataset class defined successfully!\")"
   ]
  },
