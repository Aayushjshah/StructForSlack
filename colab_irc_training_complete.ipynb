    "# Print model info\n",
    "memory_info = model.get_memory_usage()\n",
    "print(f\"\\nModel Memory Usage:\")\n",
    "print(f\"Total parameters: {memory_info['total_params']:,}\")\n",
    "print(f\"Trainable parameters: {memory_info['trainable_params']:,}\")\n",
    "print(f\"Parameter memory: {memory_info['param_memory_mb']:.1f} MB\")\n",
