   "source": [
    "class ColabConfig:\n",
    "    def __init__(self):\n",
    "        self.detect_environment()\n",
    "        self.configure_memory_settings()\n",
    "        \n",
    "    def detect_environment(self):\n",
    "        self.is_colab = 'google.colab' in sys.modules\n",
    "        self.device_type = 'cpu'\n",
    "        self.available_memory = 0\n",
    "        \n",
    "        if torch.cuda.is_available():\n",
    "            self.device_type = 'cuda'\n",
    "            self.device = torch.device('cuda')\n",
    "            self.available_memory = torch.cuda.get_device_properties(0).total_memory / 1e9\n",
    "            print(f\"🔥 CUDA GPU detected: {torch.cuda.get_device_name(0)}\")\n",
    "            print(f\"💾 Available GPU memory: {self.available_memory:.1f} GB\")\n",
    "        else:\n",
    "            self.device = torch.device('cpu')\n",
    "            print(\"💻 Using CPU for training\")\n",
    "    \n",
    "    def configure_memory_settings(self):\n",
    "        if self.device_type == 'cuda':\n",
    "            if self.available_memory < 8:\n",
    "                self.max_seq_length = 128\n",
    "                self.train_batch_size = 1\n",
    "                self.eval_batch_size = 2\n",
    "                self.gradient_accumulation_steps = 8\n",
    "            elif self.available_memory < 16:\n",
    "                self.max_seq_length = 256\n",
    "                self.train_batch_size = 2\n",
    "                self.eval_batch_size = 4\n",
    "                self.gradient_accumulation_steps = 4\n",
    "            else:\n",
    "                self.max_seq_length = 512\n",
    "                self.train_batch_size = 4\n",
    "                self.eval_batch_size = 8\n",
    "                self.gradient_accumulation_steps = 2\n",
    "        else:\n",
    "            self.max_seq_length = 128\n",
    "            self.train_batch_size = 1\n",
    "            self.eval_batch_size = 1\n",
    "            self.gradient_accumulation_steps = 4\n",
    "        \n",
    "        print(f\"⚙️ Optimized settings:\")\n",
    "        print(f\"   📏 Sequence length: {self.max_seq_length}\")\n",
    "        print(f\"   📦 Train batch size: {self.train_batch_size}\")\n",
    "        print(f\"   🔄 Gradient accumulation: {self.gradient_accumulation_steps}\")\n",
    "\n",
    "# Initialize configuration\n",
    "config = ColabConfig()\n",
    "\n",
    "# Training parameters\n",
    "PARAMS = {\n",
    "    'model_name': 'bert-base-uncased',\n",
    "    'max_previous_utterance': 3,\n",
    "    'num_epochs': 3,\n",
    "    'learning_rate': 2e-5,\n",
    "    'seed': 42,\n",
    "    'output_dir': './colab_output',\n",
    "    'cache_dir': './cached_models',\n",
    "    'quick_test': True,  # Set to False for full training\n",
    "    'limit_examples': 50  # Limit for testing\n",
    "}\n",
    "\n",
    "print(f\"\\n📋 Training Parameters:\")\n",
    "for key, value in PARAMS.items():\n",
    "    print(f\"   {key}: {value}\")"
   ]
