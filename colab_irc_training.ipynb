    "id": "model_definition"
   },
   "outputs": [],
   "source": [
    "class MemoryOptimizedBertV2(BertPreTrainedModel):\n",
    "    def __init__(self, config, hidden_size=64):\n",
    "        super().__init__(config)\n",
    "        \n",
    "        self.hidden_size = hidden_size\n",
    "        self.bert = BertModel(config)\n",
    "        self.dropout = nn.Dropout(config.hidden_dropout_prob)\n",
    "        self.pooler = nn.Linear(config.hidden_size, self.hidden_size)\n",
    "        self.pooler_activation = nn.Tanh()\n",
    "        self.classifier = nn.Linear(self.hidden_size, 1)\n",
    "        \n",
    "        self.init_weights()\n",
    "    \n",
    "    def forward(self, input_ids=None, attention_mask=None, token_type_ids=None, labels=None, **kwargs):\n",
    "        if self.training:\n",
    "            self.bert.encoder.gradient_checkpointing = True\n",
    "        \n",
    "        num_labels = input_ids.shape[1] if input_ids is not None else 1\n",
    "        \n",
    "        # Reshape inputs\n",
    "        input_ids = input_ids.view(-1, input_ids.size(-1)) if input_ids is not None else None\n",
    "        attention_mask = attention_mask.view(-1, attention_mask.size(-1)) if attention_mask is not None else None\n",
    "        token_type_ids = token_type_ids.view(-1, token_type_ids.size(-1)) if token_type_ids is not None else None\n",
    "        \n",
    "        outputs = self.bert(\n",
    "            input_ids=input_ids,\n",
    "            attention_mask=attention_mask,\n",
    "            token_type_ids=token_type_ids,\n",
    "            output_attentions=False,\n",
    "            output_hidden_states=False\n",
    "        )\n",
    "        \n",
    "        sequence_output = outputs[0]\n",
    "        cls_rep = sequence_output[:, 0, :]\n",
    "        \n",
    "        pooled_output = self.pooler_activation(self.pooler(cls_rep))\n",
    "        pooled_output = self.dropout(pooled_output)\n",
    "        \n",
    "        pooled_output = pooled_output.view(-1, num_labels, self.hidden_size)\n",
    "        logits = self.classifier(pooled_output).squeeze(-1)\n",
    "        \n",
    "        outputs = (logits,)\n",
    "        \n",
    "        if labels is not None:\n",
    "            loss_fct = nn.CrossEntropyLoss()\n",
    "            loss = loss_fct(logits, labels)\n",
    "            outputs = (loss,) + outputs\n",
    "        \n",
    "        return outputs\n",
    "\n",
    "print(\"✅ Model class defined successfully!\")"
   ]
  },
