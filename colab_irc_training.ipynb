    "def process_data(data_dir, mode, max_previous_utterance=3, limit=None):\n",
    "    print(f\"📂 Loading {mode} examples from {data_dir}\")\n",
    "    \n",
    "    mode_dir = os.path.join(data_dir, mode)\n",
    "    if not os.path.exists(mode_dir):\n",
    "        raise FileNotFoundError(f\"Directory {mode_dir} not found\")\n",
    "    \n",
    "    examples = []\n",
    "    files = os.listdir(mode_dir)\n",
    "    ascii_files = [f for f in files if f.endswith('.ascii.txt')]\n",
    "    \n",
    "    if limit:\n",
    "        ascii_files = ascii_files[:limit]\n",
    "        print(f\"📝 Limited to {len(ascii_files)} files for testing\")\n",
    "    \n",
    "    for file in tqdm(ascii_files, desc=f\"Processing {mode} files\"):\n",
    "        file_path = os.path.join(mode_dir, file)\n",
    "        try:\n",
    "            text_ascii = [line.strip().split() for line in open(file_path, encoding='utf-8', errors='ignore')]\n",
    "            \n",
    "            label_file = file_path.replace('.ascii.txt', '.annotation.txt')\n",
    "            if os.path.exists(label_file):\n",
    "                labels = [line.strip().split() for line in open(label_file, encoding='utf-8', errors='ignore')]\n",
    "                examples.append({\n",
    "                    'filename': file.split('.')[0],\n",
    "                    'text_ascii': text_ascii,\n",
    "                    'labels': labels\n",
    "                })\n",
    "        except Exception as e:\n",
    "            print(f\"⚠️ Error processing {file}: {e}\")\n",
    "            continue\n",
    "    \n",
    "    processed_examples = []\n",
    "    \n",
    "    for example in tqdm(examples, desc=\"Reshaping examples\"):\n",
    "        if not example['labels']:\n",
    "            continue\n",
    "            \n",
    "        main_text_indices = [int(label[1]) for label in example['labels'] if len(label) >= 2]\n",
    "        if not main_text_indices:\n",
    "            continue\n",
    "            \n",
    "        begin, end = min(main_text_indices), max(main_text_indices)\n",
    "        \n",
    "        for i in range(begin, min(end + 1, len(example['text_ascii']))):\n",
    "            try:\n",
    "                label = 0\n",
    "                for label_line in example['labels']:\n",
    "                    if len(label_line) >= 2 and int(label_line[1]) == i:\n",
    "                        label = i - int(label_line[0])\n",
    "                        break\n",
    "                \n",
    "                if label >= max_previous_utterance:\n",
    "                    label = 0\n",
    "                \n",
    "                # Create a single text pair for simplicity\n",
    "                if i < len(example['text_ascii']):\n",
    "                    current_text = ' '.join(example['text_ascii'][i]) if example['text_ascii'][i] else '[EMPTY]'\n",
    "                    context_idx = max(0, i - 1)\n",
    "                    context_text = ' '.join(example['text_ascii'][context_idx]) if context_idx < len(example['text_ascii']) and example['text_ascii'][context_idx] else '[EMPTY]'\n",
    "                    \n",
    "                    processed_examples.append({\n",
    "                        'guid': f\"{example['filename']}_{i}\",\n",
    "                        'text_a': current_text,\n",
    "                        'text_b': context_text,\n",
    "                        'label': label\n",
    "                    })\n",
    "                \n",
    "            except Exception as e:\n",
    "                continue\n",
    "    \n",
    "    return processed_examples\n",
    "\n",
    "def convert_to_features(examples, tokenizer, max_seq_length):\n",
    "    features = []\n",
    "    \n",
    "    for ex_index, example in enumerate(tqdm(examples, desc=\"Converting examples\")):\n",
    "        try:\n",
    "            text_a = str(example['text_a'])\n",
    "            text_b = str(example['text_b'])\n",
    "            \n",
    "            try:\n",
    "                tokens_a = tokenizer.tokenize(text_a)[:max_seq_length//2]\n",
    "                tokens_b = tokenizer.tokenize(text_b)[:max_seq_length//2]\n",
    "            except:\n",
    "                tokens_a = ['[UNK]']\n",
    "                tokens_b = ['[UNK]']\n",
    "            \n",
    "            tokens = ['[CLS]'] + tokens_b + ['[SEP]'] + tokens_a + ['[SEP]']\n",
    "            tokens = tokens[:max_seq_length]\n",
    "            \n",
    "            input_ids = tokenizer.convert_tokens_to_ids(tokens)\n",
    "            attention_mask = [1] * len(input_ids)\n",
    "            token_type_ids = [0] * (len(tokens_b) + 2) + [1] * (len(tokens) - len(tokens_b) - 2)\n",
    "            \n",
    "            padding_length = max_seq_length - len(input_ids)\n",
    "            input_ids += [tokenizer.pad_token_id] * padding_length\n",
    "            attention_mask += [0] * padding_length\n",
    "            token_type_ids += [0] * padding_length\n",
    "            \n",
    "            features.append({\n",
    "                'input_ids': input_ids,\n",
    "                'attention_mask': attention_mask,\n",
    "                'token_type_ids': token_type_ids,\n",
    "                'label': example['label']\n",
    "            })\n",
    "            \n",
    "        except Exception as e:\n",
    "            continue\n",
    "    \n",
    "    return features\n",
    "\n",
    "def create_data_loader(features, batch_size, is_training=False):\n",
    "    all_input_ids = torch.tensor([f['input_ids'] for f in features], dtype=torch.long)\n",
    "    all_attention_mask = torch.tensor([f['attention_mask'] for f in features], dtype=torch.long)\n",
    "    all_token_type_ids = torch.tensor([f['token_type_ids'] for f in features], dtype=torch.long)\n",
    "    all_labels = torch.tensor([f['label'] for f in features], dtype=torch.long)\n",
    "    \n",
    "    # Add choice dimension\n",
    "    all_input_ids = all_input_ids.unsqueeze(1)\n",
    "    all_attention_mask = all_attention_mask.unsqueeze(1)\n",
    "    all_token_type_ids = all_token_type_ids.unsqueeze(1)\n",
    "    \n",
    "    dataset = TensorDataset(all_input_ids, all_attention_mask, all_token_type_ids, all_labels)\n",
    "    sampler = RandomSampler(dataset) if is_training else SequentialSampler(dataset)\n",
    "    dataloader = DataLoader(dataset, sampler=sampler, batch_size=batch_size, pin_memory=True)\n",
    "    \n",
    "    return dataloader\n",
    "\n",
    "print(\"✅ Data processing functions defined!\")"
   ]
  },
