   "source": [
    "# Set seed for reproducibility\n",
    "set_seed(PARAMS['seed'])\n",
    "\n",
    "# Create output directory\n",
    "Path(PARAMS['output_dir']).mkdir(exist_ok=True)\n",
    "\n",
    "# Initialize tokenizer and model\n",
    "print(\"🤗 Loading tokenizer and model...\")\n",
    "tokenizer = BertTokenizer.from_pretrained(\n",
    "    PARAMS['model_name'],\n",
    "    cache_dir=PARAMS['cache_dir'],\n",
    "    do_lower_case=True\n",
    ")\n",
    "\n",
    "bert_config = BertConfig.from_pretrained(\n",
    "    PARAMS['model_name'],\n",
    "    cache_dir=PARAMS['cache_dir'],\n",
    "    num_labels=PARAMS['max_previous_utterance']\n",
    ")\n",
    "\n",
    "model = MemoryOptimizedBertV2(bert_config)\n",
    "model.to(config.device)\n",
    "\n",
    "print(\"✅ Model initialized!\")\n",
    "print(f\"📊 Model parameters: {sum(p.numel() for p in model.parameters()):,}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "colab_type": "text",
    "id": "data_loading"
   },
   "source": [
    "## 📚 Load and Process Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "colab": {},
    "colab_type": "code",
    "id": "load_data"
   },
   "outputs": [],
   "source": [
    "# Process training data\n",
    "train_examples = process_data(\n",
    "    data_dir, \n",
    "    'train', \n",
    "    PARAMS['max_previous_utterance'], \n",
    "    limit=PARAMS['limit_examples'] if PARAMS['quick_test'] else None\n",
    ")\n",
    "\n",
    "print(f\"📊 Loaded {len(train_examples)} training examples\")\n",
    "\n",
    "# Process development data\n",
    "dev_examples = process_data(\n",
    "    data_dir, \n",
    "    'dev', \n",
    "    PARAMS['max_previous_utterance'], \n",
    "    limit=PARAMS['limit_examples'] if PARAMS['quick_test'] else None\n",
    ")\n",
    "\n",
    "print(f\"📊 Loaded {len(dev_examples)} development examples\")\n",
    "\n",
    "# Convert to features\n",
    "train_features = convert_to_features(train_examples, tokenizer, config.max_seq_length)\n",
    "dev_features = convert_to_features(dev_examples, tokenizer, config.max_seq_length)\n",
    "\n",
    "print(f\"✅ Converted to {len(train_features)} train features, {len(dev_features)} dev features\")\n",
    "\n",
    "# Create data loaders\n",
    "train_loader = create_data_loader(train_features, config.train_batch_size, is_training=True)\n",
    "eval_loader = create_data_loader(dev_features, config.eval_batch_size, is_training=False)\n",
    "\n",
    "print(f\"📦 Created data loaders: {len(train_loader)} train batches, {len(eval_loader)} eval batches\")"
   ]
